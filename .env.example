# ---- backend ----
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
# 独自ドメインと併設サブドメインの両方を列挙する
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
# メール内リンクや署名付きURLの生成に使う。リクエストのHostからは組み立てない
DJANGO_PRIMARY_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://kintai:kintai@db:5432/kintai
TIME_ZONE=Asia/Tokyo

# サイト全体にHTTP Basic認証をかけたいとき（無料枠デモ環境の入口対策等）だけ
# 両方設定する。片方でも空なら無効（既定は無効）。
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=

# ---- frontend ----
VITE_API_BASE=/api/v1
